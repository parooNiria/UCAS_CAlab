+module csr(
+    input  wire         clk,
+    input  wire         reset,
+    //read port
+    input  wire         csr_re,
+    input  wire [13:0]  csr_num,
+    output wire [31:0]  csr_rvalue,
+    //write port
+    input  wire         csr_we,
+    input  wire [31:0]  csr_wdata,
+    input  wire [31:0]  csr_wmask,
+    //exception port
