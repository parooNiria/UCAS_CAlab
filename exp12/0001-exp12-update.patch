             valid <= 1'b0;
         end
+        else if(wb_ex || ertn_flush) begin
+            valid <= 1'b0;
+        end
         else if (handshake_fd) begin
             valid <= 1'b1;
         end
@@ -203,6 +217,11 @@ module ID(
     assign inst_st_h   = op_31_26_d[6'h0a] & op_25_22_d[4'h5];
     assign inst_ld_bu  = op_31_26_d[6'h0a] & op_25_22_d[4'h8];
