+
+    assign  exception_message = {   exception_state,   //83
+                                    inst_exception_type, //82
+                                    csr_re,   //80
+                                    csr_we,   //79
+                                    csr_wmask,//78
+                                    csr_num,  //46
+                                    csr_wdata //32
+                                };
