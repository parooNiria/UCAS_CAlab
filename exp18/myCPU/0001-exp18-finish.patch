+    input  wire [31:0] inst_sram_rdata,
+
+    //to ID
+    output        ready_go       ,
+    input         allow_in_id    ,
+    output [31:0] inst_if        ,
+    output [31:0] pc_if          ,
+    output        exception_adef ,
+    output        exception_pif  ,
+    output        exception_tlbr_fetch,
+    output        exception_ppi ,
